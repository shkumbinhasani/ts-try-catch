{
  "name": "@shkumbinhsn/try-catch-oxlint",
  "version": "0.2.0",
  "description": "Oxlint plugin to enforce try-catch patterns with @shkumbinhsn/try-catch",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "oxc",
    "typescript",
    "try-catch",
    "error-handling"
  ],
  "peerDependencies": {
    "oxlint": ">=1.80.0"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.80.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "oxlint": "^1.80.0",
    "typescript": "^5.0.0",
    "vitest": "^1.2.0"
  },
  "author": "Shkumbin Hasani",
  "license": "MIT",
  "homepage": "https://github.com/shkumbinhasani/ts-try-catch#readme",
  "bugs": {
    "url": "https://github.com/shkumbinhasani/ts-try-catch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shkumbinhasani/ts-try-catch.git",
    "directory": "packages/try-catch-oxlint"
  }
}
